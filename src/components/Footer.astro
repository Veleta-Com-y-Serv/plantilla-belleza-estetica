---
// Pie claro y centrado: nombre, eslogan, menú en una línea, redes en círculos, contacto y aviso legal.
// «Web creada con NoExpertise» se muestra si site.yaml → marca_pie no es false (plan gratis).
import { site, tel, mapa } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'claro' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-centro">
    {site.logo ? <img src={site.logo} alt={site.nombre} class="pie-logo" width="200" height="56" loading="lazy" /> : <p class="pie-nombre">{site.nombre}</p>}
    {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
    {
      redes.length > 0 && (
        <ul class="pie-redes">
          {redes.map(([red, url]) => (
            <li>
              <a href={url} rel="noopener" target="_blank" aria-label={red}>
                <Icono nombre={red} tam={18} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      site.menu.length > 0 && (
        <nav class="pie-menu" aria-label="Menú del pie">
          {site.menu.map((e) => <a href={e.url}>{e.texto}</a>)}
        </nav>
      )
    }
    <ul class="pie-datos">
      {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
      {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
      {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
    </ul>
    {c.horario && <p class="pie-horario">{c.horario}</p>}
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span>
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
