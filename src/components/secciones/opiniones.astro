---
// Opiniones: citas en tarjetas suaves con comilla grande en serif. Campos: `testimonios[]` (texto, autor),
// `nota` opcional (p. ej. de dónde salen las opiniones). Sin testimonios, la sección no se pinta.
import { seccion, valor } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const testimonios = s ? s.testimonios.filter((t) => valor(t.texto)) : [];
const nota = valor(s?.nota);
---

{
  s && testimonios.length > 0 && (
    <Seccion id={Astro.props.id}>
      <Titular alinear="centro" antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      <ul class:list={['mx-auto grid gap-6 md:grid-cols-2', testimonios.length >= 3 ? 'lg:grid-cols-3' : 'max-w-4xl']}>
        {testimonios.map((t, i) => (
          <li class:list={['tarjeta flex flex-col p-7 md:p-8', i % 2 === 1 && 'lg:translate-y-6']}>
            <span class="serif block h-10 text-6xl leading-none text-primario/40" aria-hidden="true">“</span>
            <blockquote class="serif mt-2 text-[1.2rem] leading-relaxed">{t.texto}</blockquote>
            {t.autor && <p class="mt-auto pt-6 text-xs uppercase tracking-[.2em] opacity-70">{t.autor}</p>}
          </li>
        ))}
      </ul>
      {nota && <p class="mt-14 text-center text-sm italic opacity-70">{nota}</p>}
    </Seccion>
  )
}
