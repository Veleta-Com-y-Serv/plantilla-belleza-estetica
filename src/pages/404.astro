---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada">
  <section class="degradado">
    <div class="contenedor grid justify-items-center py-20 text-center md:py-28">
      <div class="arco grid h-48 w-40 place-items-center border border-primario/30 bg-[var(--nude-suave)]">
        <span class="serif text-5xl tracking-[.08em] text-primario">404</span>
      </div>
      <h1 class="titulo-seccion mt-10">Esta página no existe</h1>
      <p class="mt-4 max-w-md opacity-75">Puede que el enlace esté mal o que la página se haya movido.</p>
      <p class="mt-9"><a class="btn" href="/">Volver al inicio</a></p>
    </div>
  </section>
</Base>
